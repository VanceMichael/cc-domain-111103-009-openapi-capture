{
  "openapi": "3.0.3",
  "servers": [
    {
      "url": "https://api.invalid/drift"
    }
  ],
  "paths": {
    "/metrics": {
      "get": {
        "operationId": "listMetrics"
      }
    }
  },
  "components": {
    "schemas": {
      "Metric": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer"
          },
          "state": {
            "type": "string",
            "enum": ["open", "closed"]
          }
        }
      }
    }
  }
}
